# Bind only to loopback. Use an SSH tunnel if accessing the VM remotely.
HOST=127.0.0.1
PORT=8787
# Latch starts this local DNS-pinning Firefox HTTP/HTTPS proxy.
EGRESS_PROXY_PORT=9788
# Keep these keys on the server. Never paste them into the browser UI.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
# Data and screenshots are retained for this many days (1-30).
RETENTION_DAYS=7
# Minimum spacing between lookups to the same provider (milliseconds).
PROVIDER_DELAY_MS=1000
# Optional OpenAI-compatible Chat Completions synthesis.
AI_API_KEY=
# Base URL, for example https://provider.example/v1; Latch appends /chat/completions.
AI_API_BASE_URL=
# Optional full endpoint override, for example https://provider.example/v1/chat/completions.
AI_API_URL=
AI_API_FORMAT=chat-completions
# Replace with the exact model identifier provided by your AI service.
AI_MODEL=
# Existing OPENAI_API_KEY and OPENAI_MODEL values remain supported as fallbacks.
